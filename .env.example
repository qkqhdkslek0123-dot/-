# ── 지갑 ──────────────────────────────────────────────
# base58 인코딩된 개인키 (절대 커밋/공유 금지). Phantom 등에서 export 가능.
WALLET_PRIVATE_KEY=

# ── RPC ───────────────────────────────────────────────
# 저지연 RPC 권장 (Helius, QuickNode, Triton 등). 무료 RPC는 트랜잭션 실패/지연이 잦음.
RPC_URL=https://api.mainnet-beta.solana.com

# ── PumpPortal ────────────────────────────────────────
# Local Trading API는 비수탁형(non-custodial)이라 API 키가 필수는 아니지만,
# 우선순위 처리가 필요하면 https://pumpportal.fun 에서 발급.
PUMPPORTAL_API_KEY=

# ── 텔레그램 알림 (선택) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 안전장치 ──────────────────────────────────────────
# true(기본값)면 실제 트랜잭션을 전송하지 않고 로직만 검증합니다.
# 반드시 며칠간 DRY_RUN=true로 로그를 확인한 뒤 false로 전환하세요.
DRY_RUN=true
